# Example systemd unit: Keystone on 127.0.0.1:8000, published by nginx (deploy/nginx/keystone.conf).
# Install: copy to /etc/systemd/system/, adjust paths and user, build the web app
# (cd web && npm ci && npm run build), then
#   systemctl daemon-reload && systemctl enable --now keystone
[Unit]
Description=Keystone ISMS
After=network.target

[Service]
User=keystone
Group=keystone
WorkingDirectory=/opt/keystone-isms
Environment=KEYSTONE_DATA_DIR=/srv/keystone
# Optional: Environment=ANTHROPIC_API_KEY=... (or set the key under Settings → AI)
ExecStart=/opt/keystone-isms/.venv/bin/uvicorn keystone.api.app:create_app --factory --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/keystone
PrivateTmp=true

[Install]
WantedBy=multi-user.target
